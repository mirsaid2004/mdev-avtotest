{
  "name": "mdev-avtotest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build_data.mjs && tsc -b && vite build && npm run check:browsers",
    "check:browsers": "es-check checkBrowser 'dist/*.js' 'dist/assets/*.js' --module --checkFeatures --ignorePolyfillable=core-js",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "data": "node scripts/build_data.mjs",
    "images": "python3 scripts/download_images.py"
  },
  "browserslist": [
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "chrome >= 87",
    "edge >= 88",
    "firefox >= 78",
    "samsung >= 14"
  ],
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "browserslist": "^4.29.1",
    "es-check": "^9.8.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.51.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "description": "Driving theory exam prep"
}
